# ---------------------------------------------------------------------------
# UTOPIA — environment
# Copy to .env.local and fill in.
#
# Development: you can leave almost everything blank. Verification codes print
# to the server console (and the checkout modal). CMS/door phrases fall back
# to the first-deploy hashes in src/server/phrase.ts if unset.
#
# Production: AUTH_SECRET, a mail transport, and UPI_VPA should be set
# in the Vercel dashboard (Settings → Environment Variables → Production).
# The real .env file is gitignored on purpose — it will never appear on GitHub.
# CMS/DOOR phrases are optional (first-deploy hashes exist). Do not put
# plaintext phrases in git if you rotate them.
# ---------------------------------------------------------------------------

# Signs tokens, hashes OTPs, hashes unlock phrases, derives pass codes.
# REQUIRED in production. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Email: pick ONE transport ---------------------------------------------
#
# Resend WITHOUT a domain (test only):
#   1. Create a key at https://resend.com/api-keys (Sending access is enough)
#   2. Set RESEND_API_KEY and MAIL_FROM=UTOPIA <onboarding@resend.dev>
#   3. Resend will only deliver to the email you signed up with.
#      Guest OTPs to other addresses will fail until you verify a domain.
#
# Live guest mail WITHOUT a domain — use Gmail SMTP instead (Option B).
# Leave RESEND_API_KEY empty if you use SMTP.

# Option A — Resend. Needs a verified domain to email anyone but you.
RESEND_API_KEY=

# Option B — Gmail (no domain). Enable 2FA, then create an App Password
# at https://myaccount.google.com/apppasswords and URL-encode @ as %40:
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=

# Sender. No domain → onboarding@resend.dev (Resend test) or your Gmail.
# After you verify a domain in Resend: UTOPIA <passes@yourdomain.com>
MAIL_FROM="UTOPIA <onboarding@resend.dev>"
MAIL_REPLY_TO=passes@avionproductions.in

# Absolute URL of the deployed site, used for Open Graph and pass QR links.
# Live Vercel hostname until a custom domain is attached:
NEXT_PUBLIC_SITE_URL=https://avionproductions.vercel.app

# --- UPI (shown in checkout after email verify) ----------------------------
# VPA is the collect address. Amount always comes from server-side pricing.
UPI_VPA=
UPI_PAYEE_NAME="AVION Productions"

# --- 12-word unlock phrases (BIP39 English wordlist) -----------------------
# Optional. If empty, the first-deploy hashes in phrase.ts are used.
# Rotate by setting new phrases here (plaintext is hashed in memory, never logged):
CMS_PHRASE=
DOOR_PHRASE=
# Or set precomputed HMAC-SHA256 hex (hashPhrase() in src/server/phrase.ts):
CMS_PHRASE_HASH=
DOOR_PHRASE_HASH=
