# ---------------------------------------------------------------------------
# UTOPIA — environment
# Copy to .env.local and fill in. Every value is optional in development:
# with none of them set, verification codes are printed to the server console
# and returned to the browser so you can test the flow end to end.
# ---------------------------------------------------------------------------

# Signs verification tokens and hashes the 6-digit codes.
# REQUIRED in production. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Email: pick ONE transport ---------------------------------------------

# Option A — Resend (https://resend.com). Simplest, no SMTP egress needed.
RESEND_API_KEY=

# Option B — any SMTP server, e.g. a Gmail app password:
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=

# Shown as the sender. Must be a domain you've verified with your provider.
MAIL_FROM="UTOPIA <passes@avionproductions.in>"
MAIL_REPLY_TO=passes@avionproductions.in

# Absolute URL of the deployed site, used for Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=https://utopia.avionproductions.in
