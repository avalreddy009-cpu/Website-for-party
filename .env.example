# ---------------------------------------------------------------------------
# UTOPIA — environment
# Copy to .env.local and fill in.
#
# Development: you can leave almost everything blank. Verification codes print
# to the server console (and the checkout modal). CMS/door phrases fall back
# to the first-deploy hashes in src/server/phrase.ts if unset.
#
# Production: AUTH_SECRET, Gmail, and UPI_VPA should be set in the Vercel
# dashboard (Settings → Environment Variables → Production). The real .env
# file is gitignored on purpose — it will never appear on GitHub.
# CMS/DOOR phrases are optional (first-deploy hashes exist). Do not put
# plaintext phrases in git if you rotate them.
# ---------------------------------------------------------------------------

# Signs tokens, hashes OTPs, hashes unlock phrases, derives pass codes.
# REQUIRED in production. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Email: Gmail is the live default (no custom domain needed) ------------
# 1. Turn on 2-Step Verification for the Google account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
#    (Google Account → Security → 2-Step Verification → App passwords)
# 3. Paste the 16-character password below. Spaces are stripped.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional overrides. If empty, mail sends as UTOPIA <GMAIL_USER>
# and replies go to GMAIL_USER.
MAIL_FROM=
MAIL_REPLY_TO=

# Fallback transports (leave empty if Gmail is set):
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
RESEND_API_KEY=

# Absolute URL of the deployed site, used for Open Graph and pass QR links.
# Live Vercel hostname until a custom domain is attached:
NEXT_PUBLIC_SITE_URL=https://avionproductions.vercel.app

# --- UPI (shown in checkout after email verify) ----------------------------
# VPA is the collect address. Amount always comes from server-side pricing.
UPI_VPA=
UPI_PAYEE_NAME="AVION Productions"

# --- 12-word unlock phrases (BIP39 English wordlist) -----------------------
# Optional. If empty, the first-deploy hashes in phrase.ts are used.
# Rotate by setting new phrases here (plaintext is hashed in memory, never logged):
CMS_PHRASE=
DOOR_PHRASE=
# Or set precomputed HMAC-SHA256 hex (hashPhrase() in src/server/phrase.ts):
CMS_PHRASE_HASH=
DOOR_PHRASE_HASH=
